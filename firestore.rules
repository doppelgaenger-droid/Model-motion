rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /creativeAssets/{assetId} {
      allow read: if request.auth != null && resource.data.uploadedBy == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.uploadedBy == request.auth.uid
        && request.resource.data.projectId is string
        && request.resource.data.keys().hasAll(['name','type','owner','projectId','uploadedBy','storagePath','downloadUrl','mimeType','size','createdAt'])
        && request.resource.data.size < 25 * 1024 * 1024
        && request.resource.data.mimeType.matches('image/.*');
      allow update, delete: if false;
    }
  }
}
