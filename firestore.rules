rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /creativeAssets/{assetId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll(['name','type','owner','storagePath','downloadUrl','mimeType','size','createdAt'])
        && request.resource.data.size < 25 * 1024 * 1024
        && request.resource.data.mimeType.matches('image/.*');
      allow update, delete: if false;
    }
  }
}
